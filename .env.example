# Copy to .env and adjust. None of these are secrets; they configure local runs.
# The .env file itself is git-ignored.

# Where the SQLite database file lives.
AIGOV_DB_PATH=data/governance.db

# Display name shown in the UI / health endpoint.
AIGOV_APP_NAME=AI Security Governance & Assurance

# Environment label: development | demo | production
AIGOV_ENV=development
